{
  "name": "urban-air-quality-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Accessible city air-quality snapshots, EPA PM2.5 NowCast and experimental statistical outlooks. Static GitHub Pages deployment.",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "next dev",
    "build": "node scripts/prepare-assets.mjs && next build",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "refresh:data": "node --experimental-strip-types scripts/refresh-data.mjs",
    "validate:data": "node --experimental-strip-types scripts/validate-data.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "export": "npm run build && node scripts/finalize-export.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.19.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "recharts": "^3.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "10.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "25.0.1",
    "postcss": "8.5",
    "prettier": "^3.10.1",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
